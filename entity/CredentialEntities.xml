<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="Credential" package="ro.flexbiz.security">
        <field name="credentialId" type="id" is-pk="true"/>
        <field name="credentialTypeEnumId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>

        <relationship type="one" title="CredentialType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="credentialTypeEnumId"/></relationship>

        <seed-data>
            <moqui.basic.EnumerationType description="Credential Type" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Login" enumId="CtLogin" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Basic" enumId="CtBasic" parentEnumId="CtLogin" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="JWT Token" enumId="CtJwtToken" parentEnumId="CtLogin" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="OAuth Token" enumId="CtOAuthToken" parentEnumId="CtLogin" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Opaque Token" enumId="CtOpaqueToken" parentEnumId="CtLogin" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Card" enumId="CtCard" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Key Pair" enumId="CtKeyPair" enumTypeId="CredentialType"/>
            <moqui.basic.Enumeration description="Certificate" enumId="CtCertificate" enumTypeId="CredentialType"/>
        </seed-data>
    </entity>
    <entity entity-name="CredentialField" package="ro.flexbiz.security">
        <field name="credentialId" type="id" is-pk="true"/>
        <field name="name" type="text-medium" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="value" type="text-long" encrypt="true"/>
        <relationship type="one" related="ro.flexbiz.security.Credential" short-alias="credential"/>
    </entity>
    <view-entity entity-name="CredentialView" package="ro.flexbiz.security">
        <member-entity entity-alias="CF" entity-name="ro.flexbiz.security.CredentialField"/>
        <member-relationship entity-alias="C" join-from-alias="CF" relationship="credential"/>
        <alias name="credentialId" entity-alias="CF"/>
        <alias name="name" entity-alias="CF"/>
        <alias name="fieldFromDate" entity-alias="CF" field="fromDate"/>
        <alias name="fieldThruDate" entity-alias="CF" field="thruDate"/>
        <alias name="value" entity-alias="CF"/>
        <alias name="credentialTypeEnumId" entity-alias="C"/>
        <alias name="description" entity-alias="C"/>
        <alias name="credentialFromDate" entity-alias="C" field="fromDate"/>
        <alias name="credentialThruDate" entity-alias="C" field="thruDate"/>
    </view-entity>
    <entity entity-name="CredentialUser" package="ro.flexbiz.security">
        <field name="credentialId" type="id" is-pk="true"/>
        <field name="userId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="authzActionEnumId" type="id" not-null="true"/>
        <relationship type="one" related="ro.flexbiz.security.Credential" short-alias="credential"/>
        <relationship type="one" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one" title="AuthzAction" related="moqui.basic.Enumeration">
            <key-map field-name="authzActionEnumId"/></relationship>
    </entity>
    <entity entity-name="CredentialUserGroup" package="ro.flexbiz.security">
        <field name="credentialId" type="id" is-pk="true"/>
        <field name="userGroupId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="authzActionEnumId" type="id" not-null="true"/>
        <relationship type="one" related="ro.flexbiz.security.Credential" short-alias="credential"/>
        <relationship type="one" related="moqui.security.UserGroup" short-alias="group"/>
        <relationship type="one" title="AuthzAction" related="moqui.basic.Enumeration">
            <key-map field-name="authzActionEnumId"/></relationship>
    </entity>
</entities>
