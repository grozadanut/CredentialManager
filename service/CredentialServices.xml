<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="find" noun="Credential" authz-action="view">
        <in-parameters>
            <parameter name="credentialId"/>
            <parameter name="credentialTypeEnumId"/>
            <parameter name="date" type="Timestamp"/>
            <parameter name="name"/>
        </in-parameters>
        <out-parameters>
            <parameter name="resultList"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="ro.flexbiz.security.CredentialUser" list="userPerm">
                <date-filter valid-date="date ?: ec.user.nowTimestamp"/>
                <econdition field-name="credentialId" ignore-if-empty="true"/>
                <econdition field-name="userId" from="ec.user.getUserId()"/>
                <econdition field-name="authzActionEnumId" operator="in" value="AUTHZA_ALL,AUTHZA_VIEW"/>
                <select-field field-name="credentialId"/>
            </entity-find>
            <entity-find entity-name="ro.flexbiz.security.CredentialUserGroup" list="userGroupPerm">
                <date-filter valid-date="date ?: ec.user.nowTimestamp"/>
                <econdition field-name="credentialId" ignore-if-empty="true"/>
                <econdition field-name="userGroupId" operator="in" from="ec.user.getUserGroupIdSet()"/>
                <econdition field-name="authzActionEnumId" operator="in" value="AUTHZA_ALL,AUTHZA_VIEW"/>
                <select-field field-name="credentialId"/>
            </entity-find>
            <entity-find entity-name="ro.flexbiz.security.CredentialView" list="resultList">
                <date-filter valid-date="date ?: ec.user.nowTimestamp" from-field-name="fieldFromDate" thru-field-name="fieldThruDate"/>
                <date-filter valid-date="date ?: ec.user.nowTimestamp" from-field-name="credentialFromDate" thru-field-name="credentialThruDate"/>
                <econditions>
                    <econdition field-name="credentialId" ignore-if-empty="true"/>
                    <econditions combine="or">
                        <econdition field-name="credentialId" operator="in" from="userPerm.credentialId"/>
                        <econdition field-name="credentialId" operator="in" from="userGroupPerm.credentialId"/>
                    </econditions>
                </econditions>
                <econdition field-name="credentialTypeEnumId" ignore-if-empty="true"/>
                <econdition field-name="name" ignore-if-empty="true"/>
                <select-field field-name="credentialId,name,value"/>
            </entity-find>
        </actions>
    </service>

</services>
